# MedMCP server (FastMCP over SSE + REST) with the eval egress guard and the
# PubMed/OpenFDA/RxNav record-replay cache.
# Build context: ai/src/ai. Same first layers as Dockerfile.runner, so the
# dependency layer is built once and shared.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY eval/requirements-eval.lock.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

COPY mcps/ ./
COPY src/shared/egress_guard.py ./egress_guard.py

EXPOSE 8002
CMD ["python", "main.py"]
