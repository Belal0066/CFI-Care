---
title: High-Level Architecture — Clinical AI System (BWS)
---

graph TD
    Clinician([Clinician])
    Dashboard[Streamlit Dashboard]

    Clinician <--> Dashboard
    Dashboard <--> FastAPI

    subgraph BWS [Core System — Belal Workstation Server]
        FastAPI[FastAPI Backend]

        subgraph ORCH [Orchestration Layer]
            LGA{LangGraph Agent}
            IC[Intent Classifier]
            RLogic{Routing Logic}
        end

        subgraph IL [Ingestion Layer]
            direction TB
            DS[Data Sources]
            JSN["Custom JSON<br/>data.json / nodes[]"]
            FHIR[FHIR R4<br/>HAPI Server / Bundles]
            CPP[ClinicalPreprocessor<br/>Parse → Normalize → Classify<br/>Tag → Sort → Build Graph]
            TN[ToonNormalizer<br/>FHIR → TOON String<br/>30-50% Token Reduction]
            DC[DocumentChunker<br/>Sentence-Boundary Sliding<br/>Window: 400 / Overlap: 50]
            EMB[Embedding<br/>Dense: bge-base-en-v1.5<br/>Sparse: SPLADE PP]
            QDB[(Qdrant Vector DB<br/>clinical_snapshots)]
            PSC[PatientStateCompiler<br/>Diagnoses · Medications<br/>Allergies · Status]
            PS[(PatientState<br/>Immutable Snapshot)]

            DS --> JSN
            DS --> FHIR
            JSN --> CPP
            FHIR --> TN
            CPP --> DC
            CPP --> PSC
            TN --> DC
            PSC --> PS
            DC --> EMB
            EMB --> QDB
        end

        subgraph RL [Retrieval Layer]
            HR[HybridRetriever<br/>Dense + Sparse Search<br/>RRF Fusion · Intent Filters]
            CA[Context Assembly<br/>QueryContext · RetrievalContext<br/>Temporal + Graph Neighborhood]
        end

        subgraph REAS [Reasoning Layer]
            CR[ClinicalReasoner<br/>Deterministic Reasoning<br/>CitedClaim · Data Sufficiency]
            MCP[MCP Client<br/>MCPToolManager — protocol client, ADR-012]
            MCPS[get_medical_data — MedMCP<br/>PubMed · OpenFDA · MedlinePlus<br/>circuit breaker per source, ADR-013]
            VIZ[render_clinical_viz — VizMCP]
            LLM[MedGemma<br/>Local: llama.cpp 4B GGUF<br/>Remote: Lightning AI 27B]
        end
    end

    GC[Generation & Citation<br/>generate + audit_claims<br/>Self-Correction Loop]

    FastAPI --> LGA
    LGA --> IC
    IC --> RLogic

    RLogic -- Patient Query --> HR
    RLogic -- General Med Query --> MCP
    RLogic -- Visualization Intent --> VIZ

    QDB <--> HR
    PS --> CA
    HR --> CA
    CA --> CR
    CR --> LLM

    MCP <--> MCPS
    MCP <--> VIZ
    MCPS --> LLM
    MCP --> LLM
    VIZ --> GC

    LLM --> GC
    GC --> LGA

