# Path to llama.cpp server binary (must support the gemma4 architecture)
LLAMA_SERVER_BIN=/home/belal/AI_System/llama.cpp/build/bin/llama-server

# Model settings
MODEL_DIR=/home/belal/CFI-Care/ai/src/DOC2FHIR/Mapper/models/unsloth-gemma-4-e4b-it-gguf
# Script will auto-detect if empty
MODEL_FILE=

# Prompt settings
SYSTEM_PROMPT_FILE=/home/belal/CFI-Care/ai/src/DOC2FHIR/Mapper/prompts/gemma4-fhir-medical.txt

# Network
HOST=0.0.0.0
PORT=8080

# RTX 2070 8GB baseline
CTX_SIZE=20000
N_GPU_LAYERS=90
PARALLEL=1
THREADS=6

# Safety and output controls
# Gemma 4 medical reasoning: temperature=1.0, top_p=0.95, top_k=64 recommended for thought mode
# Using slightly lower temp (0.7) for more deterministic FHIR JSON output
TEMP=0.7
TOP_P=0.95
MAX_TOKENS=100000
