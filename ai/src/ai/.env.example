# Environment Variables for Clinical-Graph Copilot

# ============================================================================
# Epic 1: Infrastructure (Required)
# ============================================================================

# Qdrant (Vector Database)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=clinical_snapshots
EMBEDDING_DIMENSION=768

# HAPI FHIR Server
FHIR_BASE_URL=http://localhost:8080/fhir

# ============================================================================
# Epic 2: AI & Retrieval (Required for Ticket 2.1+)
# ============================================================================

# Hugging Face Token (Optional, for downloading embedding models)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Groq API Key (Required for non-medical agents)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Ollama Server (MedGemma - locally installed)
# Ollama should be running: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medgemma-local:latest

# ============================================================================
# LLM Backend Selection
# ============================================================================
# Two backends available: "local" (llama.cpp / MedGemma 4B) or "lightning" (Lightning AI / MedGemma 27B)
# Set via ./launch.sh --local or ./launch.sh --lightning
LLM_BACKEND=local

# Llama.cpp (Local 4B — used when LLM_BACKEND=local)
LLAMACPP_BASE_URL=http://localhost:8000
LLAMACPP_MODEL=medgemma-1.5-4b-it-Q6_K.gguf

# Lightning AI (Remote 27B — used when LLM_BACKEND=lightning)
# SGLang server exposed on port 8000
LIGHTNING_BASE_URL=https://8000-01ktvamffjtq277sra9kyqvsjg.cloudspaces.litng.ai
LIGHTNING_MODEL_NAME=google/medgemma-27b-it
LIGHTNING_ACCESS_TOKEN=

# ============================================================================
# Optional: Logging & Monitoring
# ============================================================================
LOG_LEVEL=INFO
