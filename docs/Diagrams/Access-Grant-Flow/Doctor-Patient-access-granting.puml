NJS -> AuditLog : Log consent grant 
AuditLog -> NJS : Logged successfully

NJS -> nginx : creation confirmation 
nginx -> App : Grant created successfully
App -> Patient : Display confirmation
note left of Patient:Dr. who can now access your [Conditions, Encounters]"

==Registered Doctor accessing patient data==
Doctor -> Browser : Access Patient data
Browser -> nginx : req access to patient data 
nginx-> NJS: forward req

NJS -> NJS : extract doctor ID from token
NJS -> AR : Query access grant redis for dr and patient ids mapping
alt cache hit 
AR -> NJS : Access grant still in cache 
NJS -> NJS : proceed to data caching
else cache miss
NJS -> ADB : chech DB for access grant
    alt mapping found
    ADB-> NJS : access grant given (with valid TTL)
    NJS -> NJS : proceed to data caching
    else
    ADB-> NJS : mapping not found
    NJS -> nginx: return OK resp (mask patient's existence)
    nginx -> Browser: forward resp (empty)
    Browser -> Doctor : display empty results 
    end
end

== Patinet data caching (dr has access)==
NJS -> NJS : Verify signature (HMAC), validate scopes, check expiry
NJS ->PDR : check data existence through pid
alt data isn't cached  
NJS -> PDR : Cache data
else  
NJS-> NJS : proceed normally

end

