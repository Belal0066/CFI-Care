---
title: LangGraph Agent Workflow — StateGraph with Bounded Self-Correction
---

graph TD
    Start(( ))
    End((( )))

    CLASSIFY[classify<br/>IntentClassifier — regex pattern-match, not an LLM call]

    subgraph Routing ["route_intent — deterministic, precedence-ordered"]
        RM{Mode Select<br/>chat / local / mcp / auto}
        VZ{intent ==<br/>visualization?}
        MQ{is_mcp_query<br/>flag?}
        CF{confidence <<br/>0.70 threshold?}
        IG{intent in<br/>RAG-intent set?}
    end

    subgraph RAGPath ["Adaptive RAG Path"]
        RR[rag_retrieve<br/>HybridRetriever — Qdrant<br/>dense bge-base + sparse SPLADE, manual RRF]
        RGATE{retrieval grade}
        RETRY[retry_retrieval<br/>relaxed threshold, bounded x1<br/>default behavior — always on]
        REFORM[reformulate_query<br/>model-controlled rewrite<br/>off by default — ADR-010]
        INSUFF[handle_insufficient_evidence<br/>→ mcp_search or abstain<br/>off by default — ADR-010]
        REAS[reason<br/>run_deterministic_reasoning<br/>ClinicalReasoner — zero LLM/HTTP imports<br/>→ Claim + source_node_ids]
    end

    subgraph MCPath ["mcp_search — internal steps, one graph node"]
        QT[classify_mcp_question_type<br/>drug_safety / guidelines / general]
        DS[Deterministic query construction<br/>drug-safety questions]
        LO[LLM query optimization<br/>general questions]
        MCPC[MCPToolManager.call_tool<br/>MCP protocol — SSE, retry+backoff<br/>REST fallback: MCP_TRANSPORT=rest — ADR-012]
        REACT[[Bounded ReAct loop — observe/decide/act<br/>max 3 iterations, actions: get_medical_data or finish<br/>off by default — ADR-011]]
        QT --> DS --> MCPC
        QT --> LO --> MCPC
        MCPC -.->|"if mcp_react_loop_enabled"| REACT
    end

    VIZ[visualize<br/>generate_visualization → render_clinical_viz VizMCP]

    GEN[generate<br/>generate_response — LLM phrasing only<br/>polymorphic: RAG / MCP / Chat]

    AUDIT{audit_claims<br/>tier 1: source_node_ids exist — always on<br/>tier 2: NLI entailment — off by default, ADR-009<br/>max 2 retries}

    ABSTAIN[abstain<br/>fail-closed: retries exhausted, or<br/>no relevant patient data found]

    CONF[compute_confidence<br/>routing + retrieval +<br/>generation + validation]

    Start --> CLASSIFY
    CLASSIFY --> RM

    RM -- chat --> GEN
    RM -- local --> RR
    RM -- mcp --> QT
    RM -- auto --> VZ

    VZ -- yes --> VIZ
    VZ -- no --> MQ
    MQ -- yes, checked before<br/>the confidence gate --> QT
    MQ -- no --> CF
    CF -- below 0.70,<br/>safe default --> RR
    CF -- 0.70 or above --> IG
    IG -- yes --> RR
    IG -- no --> QT

    RR --> RGATE
    RGATE -- sufficient --> REAS
    RGATE -- insufficient<br/>default --> RETRY --> RR
    RGATE -- ambiguous<br/>flag on --> REFORM --> RR
    RGATE -- insufficient<br/>flag on --> INSUFF
    INSUFF -.-> QT
    INSUFF -.-> ABSTAIN
    REAS -- needs_drug_check --> QT
    REAS --> GEN

    MCPC --> GEN
    REACT --> GEN
    VIZ --> GEN

    GEN --> AUDIT
    AUDIT -- passed --> CONF
    AUDIT -- failed, retries < 2,<br/>feedback injected --> GEN
    AUDIT -- retries exhausted --> ABSTAIN
    ABSTAIN --> CONF

    CONF --> End

    style Start fill:#000000,stroke:#000000
    style End fill:#E6E6FA,stroke:#8A2BE2,stroke-width:2px

    classDef purpleNode fill:#E6E6FA,stroke:#8A2BE2,stroke-width:1px
    class CLASSIFY,RR,REAS,GEN,CONF,QT,DS,LO,MCPC,VIZ,RETRY,ABSTAIN purpleNode

    classDef orangeNode fill:#FFF3E0,stroke:#FB8C00,stroke-width:1px
    class RM,VZ,MQ,CF,IG,RGATE,AUDIT orangeNode

    classDef flagNode fill:#FFEBEE,stroke:#E53935,stroke-width:1px,stroke-dasharray: 4 2
    class REFORM,INSUFF,REACT flagNode

    style RAGPath fill:#F3F3FF,stroke:#8A2BE2,stroke-width:1px
    style MCPath fill:#F3F3FF,stroke:#8A2BE2,stroke-width:1px
    style Routing fill:#FFF8E1,stroke:#FB8C00,stroke-width:1px
