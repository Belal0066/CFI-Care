# Copy to eval/docker/.env.eval and fill in. Never commit the filled file.

# Persistent Studio disk; everything stateful (weights, index, caches, results) lives here.
EVAL_HOME=/teamspace/studios/this_studio/eval-home

# Hugging Face token with the MedGemma (Health AI Developer Foundations) terms accepted.
HF_TOKEN=

# Model under test. Dry run: MODEL=google/medgemma-4b-it SERVED=medgemma-4b
MODEL=google/medgemma-27b-text-it
SERVED=medgemma-27b
CONTEXT_LENGTH=16384
# CUDA 13 image; needs NVIDIA driver >= 580. On an older driver use lmsysorg/sglang:v0.5.19-cu129.
SGLANG_IMAGE=lmsysorg/sglang:v0.5.20-runtime
# e.g. --enable-deterministic-inference (record in EVAL.md whether it was on)
SGLANG_EXTRA_ARGS=

QDRANT_COLLECTION_NAME=mimic_demo_fhir
EVAL_CONCURRENCY=8

# MedMCP external evidence (optional keys raise rate limits). Cache mode:
# record (dry run on the small model), replay (GPU session), strict (reruns).
NCBI_API_KEY=
OPENFDA_API_KEY=
MCP_HTTP_CACHE_MODE=replay

# LangSmith (SaaS): open data only; the runner refuses otherwise.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Scoring after the session (Groq, OpenAI-compatible).
JUDGE_API_KEY=
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_REASONING_EFFORT=medium

GIT_SHA=
