# Groq API Key (used by the MedMCP router)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Chart normalization stays on-host (rule-based) by default. Set to true to instead send the
# patient observations being plotted to Groq (third-party API) for LLM normalization.
# Requires GROQ_API_KEY as well. See "Data Residency" in ai/README.md.
VIZ_USE_GROQ_NORMALIZER=false
