' '     Keycloak -> NodeJS : new Access token , new Refresh token , new ID token
' '     NodeJS -> NodeJS : validate new tokens
' '      nginx -> NodeJS : proxy request , forward sanitized authorization
' '     NodeJS -> NodeJS : enforce resource authorization checks
' '     alt resource available in cache
' '         NodeJS -> Redis : get resource from cache
' '         Redis -> NodeJS : resource
' '     else resource not in cache
' '         NodeJS -> FHIR : request resource with Access token
' '         FHIR -> NodeJS : resource
' '         NodeJS -> Redis : store resource in cache
' '         Redis -> NodeJS : ack
' '     end
' ' else access token valid
' '     nginx -> NodeJS : proxy request , forward sanitized authorization
' '     NodeJS -> NodeJS : enforce resource authorization checks
' '     alt resource available in cache
' '         NodeJS -> Redis : get resource from cache
' '         Redis -> NodeJS : resource
' '     else resource not in cache
' '         NodeJS -> FHIR : request resource with Access token
' '         FHIR -> NodeJS : resource
' '         NodeJS -> Redis : store resource in cache
' '         Redis -> NodeJS : ack
' '     end
' ' else access token not valid
