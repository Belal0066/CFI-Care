  {
    "id": "enc-90a18ecf-c418-41a0-b5ea-7b9c47b6bf8c",
    "content": "Prescribed Amoxicillin\n\nStandard antibiotic course for suspected bacterial bronchitis",
    "source_node_id": "enc-90a18ecf-c418-41a0-b5ea-7b9c47b6bf8c",
