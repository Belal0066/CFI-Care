@startuml Keycloak Registration Event Listener Flow
skinparam actorStyle AWESOME
skinparam BoxPadding 10
skinparam ParticipantPadding 10
autonumber
' title Keycloak Registration Event Listener Flow

actor "New User" as User

box "Edge & Identity Boundary" #FFFDF0
    participant "Client Application" as Client
    participant "Keycloak Core" as KC
    participant "Custom Event Listener SPI" as Listener
end box

box "Backend Enforcement Layer" #F4F9FF
    participant "Node.js BFF" as BFF
    participant "HAPI FHIR Server" as FHIR
end box


== User Registration ==
User -> Client : submit registration data
Client -> KC : Initiate Registration Request
KC -> KC : Execute ALTCHA Proof-of-Work & Email OTP SPIs
KC -> KC : create user, map their role and store credentials

== Event-Driven Provisioning ==
KC -> Listener : "REGISTER" event
Listener -> KC : Client credentials grant
KC --> Listener : Service access token
Listener -> BFF : Post to the registration endpoint

== BFF Security Enforcement ==
activate BFF
BFF -> BFF : Parse token claims (iss, aud, RS256)
BFF -> BFF : Verify token against Keycloak's JWKS Endpoint
BFF -> BFF : check client_id

alt Allowed browser client mapping
  BFF -> FHIR : Create Practitioner resource
  activate FHIR
  FHIR --> BFF : 201 Created
  deactivate FHIR
  BFF --> Listener : 200 OK
else Allowed mobile client mapping
  BFF -> FHIR : Create Patient resource
  activate FHIR
  FHIR --> BFF : 201 Created
  deactivate FHIR
  BFF --> Listener : 200 OK
else Unknown or disallowed client mapping
  BFF --> Listener : 403 Forbidden
end
deactivate BFF

@enduml
