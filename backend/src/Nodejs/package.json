  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "jest --runInBand --forceExit --testPathIgnorePatterns=\"database.test\"",
    "test:all": "jest --runInBand --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit --testPathIgnorePatterns=\"database.test\"",
    "test:unit": "jest --testPathPatterns=\"__tests__/.*(validation|validateRequest|cacheHelper)\" --runInBand --forceExit",
    "test:integration": "jest --testPathPatterns=\"__tests__/.*(Service|Routes).integration|Routes.test\" --runInBand --forceExit",
    "test:e2e": "jest --testPathPatterns=\"__tests__/e2e\" --runInBand --forceExit",
    "test:history-graph": "jest --testPathPatterns=\"historyGraph/__tests__\" --runInBand --forceExit",
    "test:watch": "jest --watch"
  },
