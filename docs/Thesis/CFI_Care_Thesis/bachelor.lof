\contentsline {figure}{\numberline {5.1}{\ignorespaces OCR to HL7 FHIR Transformation Architecture}}{124}{figure.caption.201}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces \textbf {High-Level System Architecture.} The flow connects the Streamlit UI to the FastAPI backend, which orchestrates the LangGraph agent. The agent routes between the RAG pipeline (Ingestion $\rightarrow $ Qdrant $\rightarrow $ MedGemma) and the External MCP Tools (eg. PubMed Access) based on query classification.}}{128}{figure.caption.204}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces \textbf {TOON Ingestion Pipeline.} Raw FHIR JSON resources are processed by the \texttt {ToonNormalizer}, extracting semantic value and temporal metadata to create token-optimized strings before vector embedding by ModernPubMedBERT.}}{129}{figure.caption.205}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces \textbf {LangGraph Reasoning State Machine.} The decision logic for the agent, illustrating the bifurcation between \texttt {LocalRAG} (Patient Specific) and \texttt {MCPSearch} (General Knowledge) paths, converging at the grounded generation node.}}{130}{figure.caption.206}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces AI-generated longitudinal patient summary utilizing RAG to synthesize data from 10 distinct clinical encounters.}}{131}{figure.caption.207}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Diagnostic reasoning workflow showing the transition from initial clinical impressions to a final confirmed diagnosis based on patient progression.}}{132}{figure.caption.208}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Interface of the MedMCP system demonstrating a RAG (Retrieval-Augmented Generation) response. The output includes synthesized clinical guidelines supported by specific evidence sources and PMIDs.}}{132}{figure.caption.209}%
